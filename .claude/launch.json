{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "port": 3000,
      "autoPort": true,
      "runtimeArgs": [
        "dev"
      ]
    },
    {
      "name": "start",
      "runtimeExecutable": "./start.sh",
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "storybook",
        "--no-open"
      ],
      "port": 6006
    }
  ]
}
